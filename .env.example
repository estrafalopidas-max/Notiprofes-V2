# GEMINI_API_KEY: Clave de API opcional para funciones de servidor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base donde se aloja la aplicación en NAS / Cloud.
APP_URL="http://localhost:3000"

# DATA_DIR: Ruta de almacenamiento persistente en el servidor (Docker / TrueNAS).
# Por defecto utiliza /app/data si está disponible o ./data localmente.
DATA_DIR="/app/data"

# SESSION_SECRET: Secreto de servidor para firma de sesiones directivas.
SESSION_SECRET="CHANGE_ME_IN_TRUENAS_ENV"

# CONFIGURACIÓN SMTP (Notificaciones automáticas por correo al publicar boletín)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notiprofes@ievillaflora.edu.co"
SMTP_PASS="CHANGE_ME_SMTP_APP_PASSWORD"
SMTP_FROM="NotiProfes Digital I.E. Villa Flora <notiprofes@ievillaflora.edu.co>"

